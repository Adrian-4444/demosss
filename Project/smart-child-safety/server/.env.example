# ==============================================================================
# Smart Child Monitoring and Safety System - Environment Configuration
# ==============================================================================
# Copy this file to .env and provide your local or environment values.
# NEVER commit .env or any file containing real credentials or secrets to Git.

# --- Application Settings ---
PROJECT_NAME="Smart Child Monitoring and Safety System"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Database (PostgreSQL / Neon) ---
# For local dev / testing, SQLite can be used: sqlite:///./local.db
# For production (Render / Neon): postgresql+psycopg://user:password@ep-xyz.region.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smart_child_safety
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# --- Security & CORS ---
# In production, provide a JSON list or comma-separated list of allowed origins.
# Wildcard origins are not permitted when using credentials.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","0.0.0.0"]

# --- Pairing & Safety Configuration ---
PAIRING_CODE_EXPIRY_MINUTES=15
PAIRING_MAX_ATTEMPTS=5
LOCATION_STALE_MINUTES=15
LOCATION_RETENTION_DAYS=30

# --- Firebase Authentication & FCM ---
# Firebase Project ID from the Firebase console
FIREBASE_PROJECT_ID=smart-child-safety-demo
# Local path to service account JSON (optional; leave empty if using JSON string or mock)
FIREBASE_CREDENTIALS_PATH=
# Service account JSON string encoded for cloud hosting (Render secret)
FIREBASE_CREDENTIALS_JSON=
